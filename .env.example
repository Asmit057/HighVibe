# Copy this file to .env (git-ignored), fill in what you need, then restart the services.
# Everything is optional: without an AI key HighVibe runs the offline demo generator.

# ---------------------------------------------------------------- AI (Google Gemini, free tier)
# gemini | demo | auto (auto = Gemini when a Gemini key is set, otherwise the demo generator)
AI_PROVIDER=auto
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra keys, comma-separated (no spaces needed). They are used in turn; a key that is
# rate-limited or rejected rests for a while and the next one is used, then it is tried again later.
GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Used in order while the main model is overloaded or missing; the main model is tried again after
# a 5-minute rest. Comma-separated; set it to an empty value to turn fallback off.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Calls per generation before giving up, across keys and models
# GEMINI_MAX_ATTEMPTS=4

# ---------------------------------------------------------------- billing
# Stripe billing. Without it, plan changes are applied immediately (mock mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---------------------------------------------------------------- security
# Shared JWT signing key (32+ characters). Change it for any shared or hosted environment.
# JWT_SECRET_KEY=

# ---------------------------------------------------------------- server deployment
# Needed by docker-compose.prod.yml; scripts/deploy.sh fills these in for you.
# Public IP address (or domain) of the server; the site is served on http://PUBLIC_HOST
# PUBLIC_HOST=
# Passwords for PostgreSQL and MinIO inside the server's private Docker network
# DB_PASSWORD=
# MINIO_SECRET_KEY=
