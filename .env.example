# Copy this file to .env (git-ignored), fill in what you need, then restart the services.
# Everything is optional: without an AI key HighVibe runs the offline demo generator.

# ---------------------------------------------------------------- AI (Google Gemini, free tier)
# gemini | demo | auto (auto = Gemini when GEMINI_API_KEY is set, otherwise the demo generator)
AI_PROVIDER=auto
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------- billing
# Stripe billing. Without it, plan changes are applied immediately (mock mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---------------------------------------------------------------- security
# Shared JWT signing key (32+ characters). Change it for any shared or hosted environment.
# JWT_SECRET_KEY=
