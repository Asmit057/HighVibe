{
  "info": {
    "name": "HighVibe API",
    "description": "Every HighVibe backend endpoint. Run 'Auth > Sign up' (or 'Log in') first: the test scripts store the token, refresh token, user id and project id in collection variables, so the other requests work without copy-pasting. All public routes go through the API gateway ({{baseUrl}} = http://localhost:8080). The 'Internal' folder calls services directly on their own ports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accountUrl", "value": "http://localhost:9010" },
    { "key": "workspaceUrl", "value": "http://localhost:9020" },
    { "key": "email", "value": "ada@example.com" },
    { "key": "password", "value": "secret123" },
    { "key": "teammateEmail", "value": "bob@example.com" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "projectId", "value": "1" },
    { "key": "memberId", "value": "2" },
    { "key": "planId", "value": "2" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "account-service. JWT access token (HS256, 30 min) + rotating refresh token (30 days, stored hashed).",
      "item": [
        {
          "name": "Sign up",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('token', body.token);",
            "pm.collectionVariables.set('refreshToken', body.refreshToken);",
            "pm.collectionVariables.set('userId', body.user.id);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/signup",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{email}}\",\n  \"name\": \"Ada Lovelace\",\n  \"password\": \"{{password}}\"\n}" },
            "description": "Public. Creates the account (BCrypt-hashed password) and returns tokens + profile. 400 if the email exists or validation fails."
          }
        },
        {
          "name": "Log in",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('token', body.token);",
            "pm.collectionVariables.set('refreshToken', body.refreshToken);",
            "pm.collectionVariables.set('userId', body.user.id);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "description": "Public. 401 on wrong credentials."
          }
        },
        {
          "name": "Refresh token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('token', body.token);",
            "pm.collectionVariables.set('refreshToken', body.refreshToken);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "description": "Public. Rotates the refresh token: the old one is revoked. Re-using a revoked token is treated as theft and revokes every session of the user (401)."
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me", "description": "Profile of the user in the JWT. 401 without a valid token." }
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "description": "Revokes the refresh token. 204."
          }
        }
      ]
    },
    {
      "name": "Billing",
      "description": "account-service. Plans, subscriptions and Stripe. Without STRIPE_SECRET_KEY, checkout switches plans instantly (mock mode).",
      "item": [
        { "name": "List plans", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/billing/plans", "description": "Public plan catalog: Free, Pro, Business with their limits." } },
        { "name": "My subscription", "request": { "method": "GET", "url": "{{baseUrl}}/api/billing/subscription", "description": "Current plan; users without a paid plan are on Free." } },
        {
          "name": "Checkout (change plan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/billing/checkout",
            "body": { "mode": "raw", "raw": "{\n  \"planId\": {{planId}}\n}" },
            "description": "Returns a Stripe Checkout URL, or {mock:true} when the plan was applied directly. Choosing Free downgrades."
          }
        },
        { "name": "Billing portal", "request": { "method": "POST", "url": "{{baseUrl}}/api/billing/portal", "description": "Stripe Customer Portal URL (manage card / cancel)." } },
        {
          "name": "Stripe webhook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Stripe-Signature", "value": "t=0,v1=invalid" }],
            "url": "{{baseUrl}}/api/billing/webhook",
            "body": { "mode": "raw", "raw": "{ \"id\": \"evt_test\", \"type\": \"checkout.session.completed\" }" },
            "description": "Called by Stripe. Signature-verified, so this sample is rejected with 400; use 'stripe listen --forward-to localhost:8080/api/billing/webhook' to send real events."
          }
        }
      ]
    },
    {
      "name": "Projects",
      "description": "workspace-service. Role-based: OWNER, EDITOR, VIEWER.",
      "item": [
        {
          "name": "Create project",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('projectId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/projects",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Habit tracker\",\n  \"description\": \"A habit tracker with streaks\"\n}" },
            "description": "Caller becomes OWNER; the project is seeded with the React + Vite + Tailwind starter. 429 when the plan's project limit is reached."
          }
        },
        { "name": "List my projects", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects", "description": "Projects where I am an accepted member, newest first." } },
        { "name": "Get project", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/{{projectId}}", "description": "VIEW. 404 if you are not a member (existence is not revealed)." } },
        {
          "name": "Rename project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Habit tracker v2\"\n}" },
            "description": "EDIT."
          }
        },
        { "name": "Download code (zip)", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/{{projectId}}/download", "description": "VIEW. Use 'Send and Download' in Postman." } },
        { "name": "Delete project", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/projects/{{projectId}}", "description": "OWNER only (DELETE permission). Soft delete; stops its preview. 204." } }
      ]
    },
    {
      "name": "Files",
      "description": "workspace-service. Bodies in MinIO, metadata in PostgreSQL, tree cached in Redis.",
      "item": [
        { "name": "File tree", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/{{projectId}}/files", "description": "VIEW." } },
        { "name": "Read file", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/files/content?path=src/App.tsx", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "files", "content"], "query": [{ "key": "path", "value": "src/App.tsx" }] }, "description": "VIEW." } },
        {
          "name": "Save file",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/projects/{{projectId}}/files/content",
            "body": { "mode": "raw", "raw": "{\n  \"path\": \"src/notes.md\",\n  \"content\": \"# Notes\\nEdited from Postman\"\n}" },
            "description": "EDIT. Creates or overwrites; the running preview hot-reloads. 400 for unsafe paths such as ../../etc."
          }
        },
        { "name": "Delete file", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/files/content?path=src/notes.md", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "files", "content"], "query": [{ "key": "path", "value": "src/notes.md" }] }, "description": "EDIT. 204." } }
      ]
    },
    {
      "name": "Live preview",
      "description": "workspace-service. Starting is asynchronous: poll 'Preview status' until RUNNING.",
      "item": [
        { "name": "Start preview", "request": { "method": "POST", "url": "{{baseUrl}}/api/projects/{{projectId}}/deploy", "description": "VIEW. 202 with status CREATING (npm install + vite). Reuses a running preview. 429 above the plan's preview limit." } },
        { "name": "Preview status", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/{{projectId}}/preview", "description": "CREATING / RUNNING (previewUrl set) / FAILED (failureReason) / TERMINATED." } },
        { "name": "Stop preview", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/projects/{{projectId}}/preview", "description": "204." } }
      ]
    },
    {
      "name": "Team",
      "description": "workspace-service. Only the OWNER manages members; invitations must be accepted.",
      "item": [
        { "name": "List members", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/{{projectId}}/members", "description": "VIEW. Includes pending invitations (acceptedAt = null)." } },
        {
          "name": "Invite member",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('memberId', pm.response.json().userId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{teammateEmail}}\",\n  \"role\": \"VIEWER\"\n}" },
            "description": "MANAGE_MEMBERS. The invitee must have an account. 400 for OWNER role, self-invite or duplicates."
          }
        },
        {
          "name": "Change role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members/{{memberId}}",
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"EDITOR\"\n}" },
            "description": "MANAGE_MEMBERS."
          }
        },
        { "name": "Remove member / leave", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/projects/{{projectId}}/members/{{memberId}}", "description": "MANAGE_MEMBERS, or anyone removing themselves. The owner cannot be removed." } },
        { "name": "My invitations", "request": { "method": "GET", "url": "{{baseUrl}}/api/invitations", "description": "Log in as the invitee first." } },
        { "name": "Accept invitation", "request": { "method": "POST", "url": "{{baseUrl}}/api/invitations/{{projectId}}/accept", "description": "As the invitee. 204." } },
        { "name": "Decline invitation", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/invitations/{{projectId}}", "description": "As the invitee. 204." } }
      ]
    },
    {
      "name": "AI",
      "description": "intelligence-service. Google Gemini when GEMINI_API_KEY is set, otherwise the offline demo generator.",
      "item": [
        {
          "name": "Generate (SSE stream)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "text/event-stream" }],
            "url": "{{baseUrl}}/api/chat/stream",
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": {{projectId}},\n  \"message\": \"Build a habit tracker with streaks and a weekly heatmap\"\n}" },
            "description": "EDIT. Server-sent events: data:{type:'delta',text} while streaming, then data:{type:'done',message}. Files are saved through the Kafka saga afterwards. 429 when today's tokens are used up, 409 if a generation is already running."
          }
        },
        { "name": "Chat history", "request": { "method": "GET", "url": "{{baseUrl}}/api/chat/projects/{{projectId}}", "description": "VIEW. Messages with parsed events (MESSAGE, TOOL_LOG, FILE_EDIT with PENDING/CONFIRMED/FAILED)." } },
        { "name": "Usage today", "request": { "method": "GET", "url": "{{baseUrl}}/api/usage/today", "description": "Tokens used today vs the plan's daily limit." } }
      ]
    },
    {
      "name": "Internal (service-to-service)",
      "description": "Not routed by the gateway. Services call these through Feign with the user's JWT; here you call the service ports directly with your token.",
      "item": [
        { "name": "account: user by id", "request": { "method": "GET", "url": "{{accountUrl}}/internal/v1/users/{{userId}}" } },
        { "name": "account: users by ids", "request": { "method": "GET", "url": { "raw": "{{accountUrl}}/internal/v1/users?ids={{userId}}", "host": ["{{accountUrl}}"], "path": ["internal", "v1", "users"], "query": [{ "key": "ids", "value": "{{userId}}" }] } } },
        { "name": "account: user by email", "request": { "method": "GET", "url": { "raw": "{{accountUrl}}/internal/v1/users/by-email?email={{email}}", "host": ["{{accountUrl}}"], "path": ["internal", "v1", "users", "by-email"], "query": [{ "key": "email", "value": "{{email}}" }] } } },
        { "name": "account: my current plan", "request": { "method": "GET", "url": "{{accountUrl}}/internal/v1/billing/current-plan" } },
        { "name": "workspace: file tree", "request": { "method": "GET", "url": "{{workspaceUrl}}/internal/v1/projects/{{projectId}}/files/tree" } },
        { "name": "workspace: file content", "request": { "method": "GET", "url": { "raw": "{{workspaceUrl}}/internal/v1/projects/{{projectId}}/files/content?path=src/App.tsx", "host": ["{{workspaceUrl}}"], "path": ["internal", "v1", "projects", "{{projectId}}", "files", "content"], "query": [{ "key": "path", "value": "src/App.tsx" }] } } },
        { "name": "workspace: check permission", "request": { "method": "GET", "url": { "raw": "{{workspaceUrl}}/internal/v1/projects/{{projectId}}/permissions/check?permission=EDIT", "host": ["{{workspaceUrl}}"], "path": ["internal", "v1", "projects", "{{projectId}}", "permissions", "check"], "query": [{ "key": "permission", "value": "EDIT" }] } } }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Gateway health", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/actuator/health" } },
        { "name": "Account service health", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{accountUrl}}/actuator/health" } },
        { "name": "Eureka registry (open in a browser)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "http://localhost:8761/eureka/apps", "header": [{ "key": "Accept", "value": "application/json" }] } }
      ]
    }
  ]
}
